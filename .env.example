# CompanyAI - Gemini API configuration
# Create a Google AI Studio API key and paste it below.
# Never commit your real .env file.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Free-tier friendly high-throughput model used by specialist agents.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Semantic LLM router (no deterministic phrase routing).
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_ROUTER_MIN_CONFIDENCE=0.72

# Gemini embedding model used by policy RAG.
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

RAG_COLLECTION=company_policies
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
# Keep results no more than this cosine-score distance below the best match.
RAG_MAX_SCORE_DROP=0.12
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite

# Ignored local runtime data. Relative paths resolve from the project root.
COMPANYAI_DB_PATH=.companyai_runtime/company.db
COMPANYAI_QDRANT_PATH=.companyai_runtime/qdrant

# Local telemetry defaults; do not enable untrusted tracestate propagation until
# ADK supports the patched OpenTelemetry API (see docs/SECURITY.md).
OTEL_PROPAGATORS=baggage
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
